---
import { db } from '../config/firebase'
import { collection, getDocs, query, orderBy } from 'firebase/firestore'
import type { ExperienceInterface } from '../types'

const q = query(collection(db, 'experiences'), orderBy('order', 'asc'))
const querySnapshot = await getDocs(q)

const experiences = querySnapshot.docs.map(doc => {
	const data = doc.data()
	return {
		id: doc.id,
		role: data.role ?? '',
		business: data.business ?? '',
		date: data.date ?? '',
		description: data.description ?? [],
	}
}) as ExperienceInterface[]
---

<div class="l-jobs">
	{experiences.map(experience => (
		<article class="job">
			<div class="job__meta">
				<h3 class="job__role">{experience.role}</h3>
				<h4 class="job__business">{experience.business}</h4>
				<p class="job__date">{experience.date}</p>
			</div>
			<div class="job__desc">
				<ul>
					{experience.description.map(line => (
						<li>{line}</li>
					))}
				</ul>
			</div>
		</article>
	))}
</div>
