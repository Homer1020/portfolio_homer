---
  const { name, role, testimonial, avatar } = Astro.props
  console.log(avatar)
---
  <blockquote>
    <div>
      <i class="decoration fa fa-quote-left"></i>
    </div>
    <p class="bq__text">{ testimonial }</p>

    <div class="profile">
      <img class="avatar" src={ `${ avatar }` } alt="">

      <div>
        <p class="profile__name">{ name }</p>
        <p class="profile__role">{ role }</p>
      </div>
    </div>
  </blockquote>

  <style lang="scss">
    @use '../styles/mixins/theme' as theme;

    .decoration {
      color: var(--secondary);
      font-size: 5.5rem;
      opacity: 0.9;
    }

    .avatar {
      width: 6rem !important;
      height: 6rem !important;
      object-fit: cover;
      border-radius: 50%;
      border: 2px solid var(--primary);
    }

    .profile {
      justify-content: center;
      display: flex;
      align-items: center;
      margin-top: 2rem;
      gap: 1.5rem;
    }

    .profile__name,
    .profile__role {
      margin: 0;
      line-height: 1.5;
    }

    .profile__name {
      font-weight: bold;
      font-size: 1.6rem;
      @include theme.theme-property('color', 'headings');
    }

    .profile__role {
      font-size: 1.4rem;
      @include theme.theme-property('color', 'legendText');
    }

    blockquote {
      @include theme.theme-property('background-color', 'sectionBg');
      @include theme.theme-property('border', 'figureBorder');
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.15);
      border-radius: 12px;
      padding: 4rem 3rem;
      margin-bottom: 2rem;
      text-align: center;
      transition: transform .25s ease, box-shadow .25s ease;

      &:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.2);
      }
    }

    .bq__text {
      font-size: 1.6rem;
      line-height: 1.6;
      margin-top: 2.5rem;
      margin-bottom: 2.7rem;
      @include theme.theme-property('color', 'articleText');
    }

    @media (min-width: 1200px) {
      blockquote {
        padding: 4rem 5rem;
        margin-left: 2rem;
        margin-right: 2rem;
      }

      .bq__text {
        line-height: 1.7;
        margin-bottom: 2.5rem;
      }
    }
  </style>