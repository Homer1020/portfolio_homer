---
import { db } from '../config/firebase'
import { collection, getDocs, query, orderBy } from 'firebase/firestore'
import type { StackInterface } from '../types'
import defaultStacks from '../data/stacks.json'

let stacks: Array<{ path: string; darkPath?: string; tech: string }> = []

try {
  const q = query(collection(db, 'stacks'), orderBy('order', 'asc'))
  const querySnapshot = await getDocs(q)

  const dbStacks = querySnapshot.docs
    .map(doc => {
      const data = doc.data()
      return {
        id: doc.id,
        name: data.name ?? '',
        icon: data.icon ?? '',
        darkIcon: data.darkIcon ?? '',
        order: data.order ?? 0,
        draft: data.draft ?? false,
      }
    })
    .filter(item => !item.draft) as StackInterface[]

  if (dbStacks.length > 0) {
    stacks = dbStacks.map(s => ({
      path: s.icon,
      darkPath: s.darkIcon || undefined,
      tech: s.name,
    }))
  } else {
    stacks = defaultStacks.map(s => ({
      path: s.icon,
      darkPath: s.darkIcon || undefined,
      tech: s.name,
    }))
  }
} catch (e) {
  stacks = defaultStacks.map(s => ({
    path: s.icon,
    darkPath: s.darkIcon || undefined,
    tech: s.name,
  }))
}
---

<ul class="l-stack">
  {
    stacks.map(({ path, darkPath, tech }) => (
      <li class="l-stack__item">
        <figure>
          {
            darkPath ? (
              <>
                <img src={path} alt={tech} class="l-stack__img--light" />
                <img src={darkPath} alt={tech} class="l-stack__img--dark" />
              </>
            ) : (
              <img src={path} alt={tech} />
            )
          }
          <figcaption>{tech}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>