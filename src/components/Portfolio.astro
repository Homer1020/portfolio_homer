---
import Project from "./Project.astro";
import { db } from "../config/firebase";
import { collection, getDocs } from "firebase/firestore";
import type { ProjectInterface } from "../types";

// 1. Obtener los proyectos directamente desde Firestore
const querySnapshot = await getDocs(collection(db, "projects"));

const projects = (
  querySnapshot.docs.map((doc) => {
    const data = doc.data();
    return {
      ...data,
      slug: doc.id, // Aseguramos el slug usando el ID del documento
    };
  }) as ProjectInterface[]
).filter((project) => !project.draft);
---

<div id="filter-portfolio">
  <button class="button button--sm button--dark-o" data-filter="*"
    >Mostrar todo</button
  >
  <button class="button button--sm button--dark-o" data-filter=".php"
    >PHP</button
  >
  <button class="button button--sm button--dark-o" data-filter=".laravel"
    >Laravel</button
  >
  <button class="button button--sm button--dark-o" data-filter=".javascript"
    >JavaScript</button
  >
  <button class="button button--sm button--dark-o" data-filter=".reactjs"
    >ReactJS</button
  >
  <button class="button button--sm button--dark-o" data-filter=".wordpress"
    >Wordpress</button
  >
  <button class="button button--sm button--dark-o" data-filter=".nodejs"
    >NodeJS</button
  >
</div>

<!-- Guardamos los proyectos mapeados en data-projects para consumirlos desde el script -->
<div
  class="l-portfolio"
  id="portfolio"
  data-projects={JSON.stringify(projects)}
>
  {projects.map((project) => <Project {...project} image={project.mockup} />)}
</div>

<style lang="scss">
  @use '../styles/mixins/theme' as theme;

  .l-portfolio {
    margin-top: 3rem;
  }

  .button {
    border-radius: 8px;
    font-size: 1.3rem;
    font-weight: 500;
    font-family: "Poppins", sans-serif;
    transition: all .2s ease;
  }

  .button.active {
    background-color: var(--primary) !important;
    color: #fff !important;
    border-color: var(--primary) !important;
    box-shadow: 0 4px 12px rgba(25, 148, 224, 0.35);
  }

  #filter-portfolio {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  #filter-portfolio button {
    margin-right: 0;
    margin-bottom: 0;
  }
</style>

<script>
  import Isotope from "isotope-layout";
  import imagesLoaded from "imagesloaded";
  import { generateModal } from "../utils/modal";
  import type { ProjectInterface } from "../types";

  const $grid = document.getElementById("portfolio") as HTMLElement;
  const $filterPortfolio = document.getElementById(
    "filter-portfolio",
  ) as HTMLElement;

  // 2. Extraer la lista de proyectos inyectada desde Astro
  const projectsData: ProjectInterface[] = JSON.parse(
    $grid.dataset.projects || "[]",
  );

  // Inicialización de Isotope
  const grid = new Isotope($grid, {
    itemSelector: "#portfolio article",
    masonry: {
      columnWidth: "#portfolio article",
      gutter: 30,
    },
  });

  // Filtros de categoría
  $filterPortfolio.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    if (target.dataset.filter) {
      $filterPortfolio.querySelectorAll(".button").forEach(($btn) => {
        $btn.classList.remove("active");
      });
      target.classList.add("active");
      grid.arrange({
        filter: target.dataset.filter,
      });
    }
  });

  // Recalcular layout cuando carguen las imágenes
  imagesLoaded($grid).on("progress", function () {
    grid.layout();
  });

  /**
   * MODAL (Ahora busca sobre la data traída dinámicamente de Firestore)
   */
  const handleShowModal = (e: MouseEvent) => {
    const $target = e.target as HTMLElement;
    if ($target.classList.contains("project-img")) {
      e.preventDefault();
      const slug = $target.parentElement?.parentElement?.dataset.projectSlug;
      const project = projectsData.find((p) => p.slug === slug);

      if (project) {
        const $modal = generateModal(project);
        if ($modal) document.body.appendChild($modal);
      }
    }
  };

  $grid.addEventListener("click", handleShowModal);
</script>
