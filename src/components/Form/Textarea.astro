---
interface Props extends astroHTML.JSX.TextareaHTMLAttributes{
  label?: string,
  errors?: string[]
}

const {errors, id, label = '', placeholder = '', ...props } = Astro.props
---

<div class="group">
  <label
    class="label"
    for={id}
  >{label}</label>
  <textarea
    class:list={[
      'input',
      {'invalid': errors?.length}
    ]}
    id={id}
    name={id}
    placeholder={placeholder},
    {...props}
  ></textarea>
  {errors?.map(error => (
    <small class="invalidFeedback">{error}</small>
  ))}
</div>