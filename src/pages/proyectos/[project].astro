---
import Layout from "../../layouts/Layout.astro"
import { db } from '../../config/firebase-server'
import type { ProjectInterface } from '../../types'

const { project: slug } = Astro.params

const projectSnap = slug ? await db.collection('projects').doc(slug).get() : null

if (!projectSnap?.exists) {
  return Astro.redirect('/', 301)
}

const data = projectSnap.data() ?? {}

const project: ProjectInterface = {
  slug: projectSnap.id,
  title: data.title ?? '',
  mockup: data.mockup ?? '',
  image: data.image ?? '',
  stacks: data.stacks ?? [],
  description: data.description ?? '',
  gallery: data.gallery ?? [],
  url: data.url ?? null,
  github: data.github ?? null,
  draft: data.draft ?? false,
}

if (project.draft) {
  return Astro.redirect('/', 301)
}
---
<Layout
  title={ project.title }
>
  <div class="container">
    <img class="banner" src={project.image} alt={project.title}>
    <div>
      <h1 class="title">{project.title}</h1>
      <h3 class="subtitle">Descripción:</h3>
      <div class="styled-content" set:html={project.description || `
        <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Dolorum itaque nam quam et? Inventore accusantium iure excepturi quam expedita enim natus blanditiis vero ea, harum quis cupiditate, voluptatem quia fugit.</p>
        <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Dolorum itaque nam quam et? Inventore accusantium iure excepturi quam expedita enim natus blanditiis vero ea, harum quis cupiditate, voluptatem quia fugit.</p>
      `.trim()}></div>
      {project.gallery && project.gallery.length > 0 && (
        <>
          <h3 class="subtitle">Galería:</h3>
          <div class="gallery">
            {project.gallery.map(url => (
              <a href={url} target="_blank" rel="noopener">
                <img src={url} alt={project.title} loading="lazy">
              </a>
            ))}
          </div>
        </>
      )}
      <h3 class="subtitle">Tecnologías:</h3>
      <ul class="list">
        {(project.stacks ?? []).map(stack => (
          <li>{stack}</li>
        ))}
      </ul>
      <div class="buttons">
        {project.github && (
          <a target="_blank" href={project.github} class="button button--secondary">
            Código
            <i class="fab fa-github"></i>
          </a>
        )}
        {project.url && (
          <a href={project.url} target="_blank" class="button button--primary">
            Preview
            <i class="fa fa-link"></i>
          </a>
        )}
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .header {
    background-color: #fff;
    box-shadow: rgba(27, 31, 35, 0.04) 0px 1px 0px, rgba(255, 255, 255, 0.25) 0px 1px 0px inset;
  }

  p {
    font-size: 1.5rem;
  }
</style>

<style>
  h3,
  h1 {
    font-weight: 500;
    line-height: 1;
  }
  
  .container {
    margin-bottom: 5rem;
    margin-top: 10rem;
  }

  h1 {
    font-size: 2.4rem;
    margin-bottom: 2rem;
    color: var(--primary);
  }

  .card {
    background-color: #fff;
    padding: 3rem;
    border-radius: 10px;
    box-shadow: rgba(0, 0, 0, 0.08) 0px 4px 12px;
  }

  .banner {
    width: 100%;
    display: block;
    margin-bottom: 3rem;
    object-fit: cover;
  }

  .list {
    list-style: none;
    margin: 1.5rem 0;
  }

  .list li {
    background-color: #eee;
    display: inline-block;
    padding: .5rem 1rem;
    border-radius: 3px;
    font-size: 1.4rem;
  }

  .list li:not(:last-child) {
    margin-right: 1rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .buttons {
    margin-top: 3rem;
  }

  .buttons a:not(:last-child) {
    margin-right: .5rem;
  }
</style>