---
import AdminLayout from '../../layouts/AdminLayout.astro'
import Input from '../../components/Form/Input.astro'

import { getFirestore } from 'firebase-admin/firestore'
import type { ProjectInterface } from '../../types'

const db = getFirestore()

const proyectosSnap = await db.collection('projects').get()

const proyectos = proyectosSnap.docs.map(doc => {
	const data = doc.data()
	return {
		slug: doc.id,
		title: data.title ?? '',
		mockup: data.mockup ?? '',
		image: data.image ?? '',
		stacks: data.stacks ?? [],
		description: data.description ?? '',
		gallery: data.gallery ?? [],
		url: data.url ?? null,
		github: data.github ?? null,
		draft: data.draft ?? false,
	}
}) as ProjectInterface[]
---

<AdminLayout title="Proyectos">
	<div class="admin-toolbar">
		<h2>Proyectos</h2>
		<button type="button" class="button button--primary button--sm" id="new-project-btn">Nuevo proyecto</button>
	</div>

	<div class="admin-table-wrapper">
		<table class="admin-table">
			<thead>
				<tr>
					<th>Imagen</th>
					<th>Título</th>
					<th>Slug</th>
					<th>Stacks</th>
					<th>Links</th>
					<th>Estado</th>
					<th>Acciones</th>
				</tr>
			</thead>
			<tbody id="projects-tbody">
				{proyectos.length === 0 && (
					<tr id="empty-row">
						<td colspan="7" class="admin-table__empty-state">No hay proyectos aún.</td>
					</tr>
				)}
				{proyectos.map(proyecto => (
					<tr data-row-slug={proyecto.slug}>
						<td>
							<img class="admin-table__thumb" src={proyecto.mockup} alt={proyecto.title} />
						</td>
						<td>{proyecto.title}</td>
						<td><code>{proyecto.slug}</code></td>
						<td>
							<div class="admin-table__tags">
								{(proyecto.stacks ?? []).map(stack => (
									<span class="admin-tag">{stack}</span>
								))}
							</div>
						</td>
						<td>
							<div class="admin-table__links">
								{proyecto.url && <a href={proyecto.url} target="_blank">Sitio</a>}
								{proyecto.github && <a href={proyecto.github} target="_blank">GitHub</a>}
								{!proyecto.url && !proyecto.github && <span class="admin-table__empty">—</span>}
							</div>
						</td>
						<td>
							<span class:list={['admin-badge', { 'admin-badge--success': !proyecto.draft }]}>
								{proyecto.draft ? 'Borrador' : 'Público'}
							</span>
						</td>
						<td>
							<div class="admin-table__actions">
								<button
									type="button"
									class="button button--sm button--secondary-o"
									data-action="toggle"
									data-slug={proyecto.slug}
									data-draft={String(proyecto.draft)}
								>{proyecto.draft ? 'Publicar' : 'Despublicar'}</button>
								<button
									type="button"
									class="button button--sm button--primary-o"
									data-action="edit"
									data-title={proyecto.title}
									data-slug={proyecto.slug}
									data-mockup={proyecto.mockup}
									data-image={proyecto.image}
									data-stacks={(proyecto.stacks ?? []).join(', ')}
									data-description={proyecto.description}
									data-gallery={JSON.stringify(proyecto.gallery ?? [])}
									data-url={proyecto.url ?? ''}
									data-github={proyecto.github ?? ''}
									data-draft={String(proyecto.draft)}
								>Editar</button>
								<button type="button" class="button button--sm button--dark-o" data-action="delete" data-slug={proyecto.slug}>Eliminar</button>
							</div>
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>

	<div class="admin-modal" id="project-modal">
		<div class="admin-modal__content">
			<button type="button" class="admin-modal__close" id="close-project-modal">
				<i class="fa fa-times"></i>
			</button>
			<h2 id="project-modal-title">Nuevo proyecto</h2>
			<form id="form-project">
				<Input type="text" id="title" label="Título" placeholder="Mi proyecto" required />
				<Input type="text" id="slug" label="Slug (ID único)" placeholder="mi-proyecto" required />
				<div class="editor-group">
					<label class="editor-label">Imagen (miniatura del listado)</label>
					<div class="cover-upload">
						<img id="mockup-preview" class="cover-upload__preview" alt="" />
						<label class="button button--secondary-o button--sm" for="mockup-input" id="mockup-upload-label">Subir imagen</label>
						<input type="file" id="mockup-input" accept="image/*" hidden />
					</div>
					<input type="hidden" id="mockup" name="mockup" />
				</div>

				<div class="editor-group">
					<label class="editor-label">Imagen (detalle del proyecto)</label>
					<div class="cover-upload">
						<img id="image-preview" class="cover-upload__preview" alt="" />
						<label class="button button--secondary-o button--sm" for="image-input" id="image-upload-label">Subir imagen</label>
						<input type="file" id="image-input" accept="image/*" hidden />
					</div>
					<input type="hidden" id="image" name="image" />
				</div>

				<Input type="text" id="stacks" label="Stacks (separados por coma)" placeholder="Astro, SCSS, Firebase" />

				<div class="editor-group">
					<label class="editor-label">Descripción</label>
					<div id="description-editor" class="wysiwyg"></div>
				</div>

				<div class="editor-group">
					<label class="editor-label">Galería de imágenes</label>
					<div class="gallery-list" id="gallery-list"></div>
					<label class="button button--secondary-o button--sm" for="gallery-input" id="gallery-upload-label">Agregar imágenes</label>
					<input type="file" id="gallery-input" accept="image/*" multiple hidden />
				</div>

				<Input type="url" id="url" label="URL del sitio" placeholder="https://..." />
				<Input type="url" id="github" label="URL de GitHub" placeholder="https://..." />

				<div class="admin-checkbox">
					<input type="checkbox" id="draft" name="draft" />
					<label for="draft">Guardar como borrador (oculto del sitio)</label>
				</div>

				<div class="admin-modal__actions">
					<button type="submit" class="button button--primary" id="submit-project-btn">Guardar</button>
				</div>
			</form>
		</div>
	</div>
</AdminLayout>

<style>
	.admin-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;

		h2 {
			font-size: 2.2rem;
		}
	}

	.admin-table-wrapper {
		background-color: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 10px;
		overflow-x: auto;
	}

	.admin-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 1.4rem;

		th, td {
			text-align: left;
			padding: 1.2rem 1.5rem;
			white-space: nowrap;
		}

		thead th {
			background-color: #f8f9fa;
			color: #6b7280;
			font-weight: 600;
			border-bottom: 1px solid #e5e7eb;
		}

		tbody tr:not(:last-child) td {
			border-bottom: 1px solid #f1f3f5;
		}
	}

	.admin-table__thumb {
		width: 56px;
		height: 40px;
		object-fit: cover;
		border-radius: 6px;
		background-color: #f1f3f5;
	}

	.admin-table__tags {
		display: flex;
		flex-wrap: wrap;
		gap: .4rem;
	}

	.admin-tag {
		background-color: #eef2ff;
		color: #4338ca;
		font-size: 1.2rem;
		font-weight: 500;
		padding: .3rem .7rem;
		border-radius: 20px;
	}

	.admin-table__links {
		display: flex;
		gap: 1rem;

		a {
			color: var(--primary);
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}
	}

	.admin-table__empty {
		color: #9ca3af;
	}

	.admin-table__empty-state {
		text-align: center;
		color: #9ca3af;
		padding: 3rem;
	}

	.admin-table__actions {
		display: flex;
		gap: .8rem;
	}

	.admin-badge {
		display: inline-block;
		font-size: 1.2rem;
		font-weight: 500;
		padding: .3rem .8rem;
		border-radius: 20px;
		background-color: #f1f3f5;
		color: #6b7280;
	}

	.admin-badge--success {
		background-color: #dcfce7;
		color: #15803d;
	}

	.admin-checkbox {
		display: flex;
		align-items: center;
		gap: .8rem;
		margin: 1.5rem 0;

		label {
			font-size: 1.4rem;
		}
	}

	.editor-group {
		margin-bottom: 1.5rem;
	}

	.editor-label {
		display: block;
		margin-bottom: .75rem;
		font-size: 1.4rem;
		font-weight: 500;
		font-family: "Poppins", sans-serif;
	}

	.wysiwyg {
		background-color: #fff;
		font-size: 1.4rem;
	}

	.wysiwyg :global(.ql-toolbar) {
		border-radius: 5px 5px 0 0;
	}

	.wysiwyg :global(.ql-container) {
		border-radius: 0 0 5px 5px;
		font-family: inherit;
	}

	.wysiwyg :global(.ql-editor) {
		min-height: 120px;
	}

	.cover-upload {
		display: flex;
		align-items: center;
		gap: 1.2rem;
	}

	.cover-upload__preview {
		width: 96px;
		height: 68px;
		object-fit: cover;
		border-radius: 6px;
		border: 1px solid #e5e7eb;
		background-color: #f1f3f5;
		display: none;
	}

	.cover-upload__preview.has-image {
		display: block;
	}

	.gallery-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
		gap: .8rem;
		margin-bottom: 1rem;
	}

	.gallery-list :global(.gallery-item) {
		position: relative;
		aspect-ratio: 1;
		border-radius: 6px;
		overflow: hidden;
	}

	.gallery-list :global(.gallery-item img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: 1px solid #e5e7eb;
		display: block;
	}

	.gallery-list :global(.gallery-item__remove) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, .55);
		color: #fff;
		border: none;
		font-size: 1.8rem;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity .15s;
	}

	.gallery-list :global(.gallery-item:hover .gallery-item__remove),
	.gallery-list :global(.gallery-item:focus-within .gallery-item__remove) {
		opacity: 1;
	}

	.admin-modal {
		display: none;
		position: fixed;
		inset: 0;
		background-color: rgba(0, 0, 0, .5);
		align-items: center;
		justify-content: center;
		padding: 2rem;
		z-index: 100;
	}

	.admin-modal.open {
		display: flex;
	}

	.admin-modal__content {
		position: relative;
		width: min(600px, 100%);
		max-height: 90vh;
		overflow-y: auto;
		background-color: #fff;
		border-radius: 10px;
		padding: 2.5rem;
	}

	.admin-modal__close {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		background: none;
		border: none;
		font-size: 1.8rem;
		cursor: pointer;
		color: #6b7280;
	}

	.admin-modal__actions {
		margin-top: 1.5rem;
	}

	.admin-modal h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
	}
</style>

<script>
	import { collection, doc, setDoc, updateDoc, deleteDoc } from 'firebase/firestore'
	import { db } from '../../config/firebase'
	import Swal from 'sweetalert2'
	import Quill from 'quill'
	import 'quill/dist/quill.snow.css'

	const $modal = document.getElementById('project-modal') as HTMLElement
	const $modalTitle = document.getElementById('project-modal-title') as HTMLElement
	const $newProjectBtn = document.getElementById('new-project-btn') as HTMLElement
	const $closeModalBtn = document.getElementById('close-project-modal') as HTMLElement
	const $form = document.getElementById('form-project') as HTMLFormElement
	const $slugInput = document.getElementById('slug') as HTMLInputElement
	const $draftInput = document.getElementById('draft') as HTMLInputElement
	const $submitBtn = document.getElementById('submit-project-btn') as HTMLButtonElement
	const $tbody = document.getElementById('projects-tbody') as HTMLElement
	const $galleryList = document.getElementById('gallery-list') as HTMLElement
	const $galleryInput = document.getElementById('gallery-input') as HTMLInputElement
	const $galleryUploadLabel = document.getElementById('gallery-upload-label') as HTMLElement
	const $mockupInput = document.getElementById('mockup-input') as HTMLInputElement
	const $mockupPreview = document.getElementById('mockup-preview') as HTMLImageElement
	const $mockupUploadLabel = document.getElementById('mockup-upload-label') as HTMLElement
	const $mockupField = document.getElementById('mockup') as HTMLInputElement
	const $imageInput = document.getElementById('image-input') as HTMLInputElement
	const $imagePreview = document.getElementById('image-preview') as HTMLImageElement
	const $imageUploadLabel = document.getElementById('image-upload-label') as HTMLElement
	const $imageField = document.getElementById('image') as HTMLInputElement

	const descriptionQuill = new Quill('#description-editor', {
		theme: 'snow',
		modules: {
			toolbar: [
				[{ header: [3, 4, false] }],
				['bold', 'italic', 'underline'],
				[{ list: 'ordered' }, { list: 'bullet' }],
				['link'],
			],
		},
	})

	let mode: 'create' | 'edit' = 'create'
	let galleryUrls: string[] = []

	const renderGallery = () => {
		$galleryList.innerHTML = ''
		galleryUrls.forEach((url, index) => {
			const $item = document.createElement('div')
			$item.className = 'gallery-item'
			$item.innerHTML = `<img src="${url}" alt=""><button type="button" class="gallery-item__remove" data-index="${index}" aria-label="Eliminar"><i class="fa fa-trash"></i></button>`
			$galleryList.appendChild($item)
		})
	}

	$galleryList.addEventListener('click', e => {
		const $btn = (e.target as HTMLElement).closest('button[data-index]') as HTMLButtonElement | null
		if (!$btn) return
		galleryUrls.splice(Number($btn.dataset.index), 1)
		renderGallery()
	})

	$galleryInput.addEventListener('change', async () => {
		const files = Array.from($galleryInput.files ?? [])
		if (!files.length) return

		$galleryInput.disabled = true
		$galleryUploadLabel.textContent = 'Subiendo...'

		for (const file of files) {
			if (!file.type.startsWith('image/')) {
				Swal.fire({ title: 'Archivo inválido', text: `"${file.name}" no es una imagen.`, icon: 'error', confirmButtonColor: 'var(--primary)' })
				continue
			}

			if (file.size > 5e6) {
				Swal.fire({ title: 'Archivo muy pesado', text: `"${file.name}" debe pesar 5mb o menos.`, icon: 'error', confirmButtonColor: 'var(--primary)' })
				continue
			}

			try {
				const fd = new FormData()
				fd.append('file', file)
				const res = await fetch('/api/admin/upload-project-image', { method: 'POST', body: fd })
				if (!res.ok) throw new Error(await res.text())
				const data = await res.json()
				galleryUrls.push(data.url)
				renderGallery()
			} catch (err) {
				Swal.fire({ title: 'Error al subir una imagen.', icon: 'error', confirmButtonColor: 'var(--primary)' })
			}
		}

		$galleryInput.disabled = false
		$galleryInput.value = ''
		$galleryUploadLabel.textContent = 'Agregar imágenes'
	})

	const setCoverPreview = ($preview: HTMLImageElement, $label: HTMLElement, url: string) => {
		$preview.src = url
		$preview.classList.toggle('has-image', Boolean(url))
		$label.textContent = url ? 'Reemplazar imagen' : 'Subir imagen'
	}

	const handleCoverUpload = async (
		file: File,
		field: 'mockup' | 'image',
		$hiddenField: HTMLInputElement,
		$preview: HTMLImageElement,
		$label: HTMLElement,
		$input: HTMLInputElement,
	) => {
		if (!$slugInput.value.trim()) {
			Swal.fire({ title: 'Completa el slug primero', icon: 'error', confirmButtonColor: 'var(--primary)' })
			$input.value = ''
			return
		}

		if (!file.type.startsWith('image/')) {
			Swal.fire({ title: 'Archivo inválido', text: 'Solo se permiten imágenes.', icon: 'error', confirmButtonColor: 'var(--primary)' })
			$input.value = ''
			return
		}

		if (file.size > 5e6) {
			Swal.fire({ title: 'Archivo muy pesado', text: 'La imagen debe pesar 5mb o menos.', icon: 'error', confirmButtonColor: 'var(--primary)' })
			$input.value = ''
			return
		}

		const originalLabel = $label.textContent
		$input.disabled = true
		$label.textContent = 'Subiendo...'

		try {
			const fd = new FormData()
			fd.append('file', file)
			fd.append('slug', $slugInput.value.trim())
			fd.append('field', field)

			const res = await fetch('/api/admin/upload-project-image', { method: 'POST', body: fd })
			if (!res.ok) throw new Error(await res.text())
			const data = await res.json()
			const bustedUrl = `${data.url}?updatedAt=${Date.now()}`

			$hiddenField.value = bustedUrl
			setCoverPreview($preview, $label, bustedUrl)
		} catch (err) {
			Swal.fire({ title: 'Error al subir la imagen.', icon: 'error', confirmButtonColor: 'var(--primary)' })
			$label.textContent = originalLabel
		} finally {
			$input.disabled = false
			$input.value = ''
		}
	}

	$mockupInput.addEventListener('change', () => {
		const file = $mockupInput.files?.[0]
		if (file) handleCoverUpload(file, 'mockup', $mockupField, $mockupPreview, $mockupUploadLabel, $mockupInput)
	})

	$imageInput.addEventListener('change', () => {
		const file = $imageInput.files?.[0]
		if (file) handleCoverUpload(file, 'image', $imageField, $imagePreview, $imageUploadLabel, $imageInput)
	})

	const openModal = () => {
		$modal.classList.add('open')
		document.body.style.overflow = 'hidden'
	}

	const closeModal = () => {
		$modal.classList.remove('open')
		document.body.style.overflow = ''
	}

	const openCreateModal = () => {
		mode = 'create'
		$modalTitle.textContent = 'Nuevo proyecto'
		$form.reset()
		$slugInput.readOnly = false
		$draftInput.checked = true
		descriptionQuill.setText('')
		galleryUrls = []
		renderGallery()
		setCoverPreview($mockupPreview, $mockupUploadLabel, '')
		setCoverPreview($imagePreview, $imageUploadLabel, '')
		openModal()
	}

	const openEditModal = (button: HTMLElement) => {
		mode = 'edit'
		$modalTitle.textContent = 'Editar proyecto'
		$form.reset()
		;(document.getElementById('title') as HTMLInputElement).value = button.dataset.title ?? ''
		;(document.getElementById('slug') as HTMLInputElement).value = button.dataset.slug ?? ''
		;(document.getElementById('mockup') as HTMLInputElement).value = button.dataset.mockup ?? ''
		;(document.getElementById('image') as HTMLInputElement).value = button.dataset.image ?? ''
		setCoverPreview($mockupPreview, $mockupUploadLabel, button.dataset.mockup ?? '')
		setCoverPreview($imagePreview, $imageUploadLabel, button.dataset.image ?? '')
		;(document.getElementById('stacks') as HTMLInputElement).value = button.dataset.stacks ?? ''
		descriptionQuill.setText('')
		descriptionQuill.clipboard.dangerouslyPasteHTML(button.dataset.description ?? '')
		galleryUrls = JSON.parse(button.dataset.gallery ?? '[]')
		renderGallery()
		;(document.getElementById('url') as HTMLInputElement).value = button.dataset.url ?? ''
		;(document.getElementById('github') as HTMLInputElement).value = button.dataset.github ?? ''
		$slugInput.readOnly = true
		$draftInput.checked = button.dataset.draft === 'true'
		openModal()
	}

	$newProjectBtn.addEventListener('click', openCreateModal)
	$closeModalBtn.addEventListener('click', closeModal)

	$modal.addEventListener('click', e => {
		if (e.target === $modal) closeModal()
	})

	$tbody.addEventListener('click', async e => {
		const $button = (e.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null
		if (!$button) return

		const slug = $button.dataset.slug as string

		if ($button.dataset.action === 'edit') {
			openEditModal($button)
		}

		if ($button.dataset.action === 'toggle') {
			const draft = $button.dataset.draft === 'true'

			try {
				await updateDoc(doc(db, 'projects', slug), { draft: !draft })
				window.location.reload()
			} catch (err) {
				Swal.fire({
					title: 'Error al actualizar el proyecto.',
					icon: 'error',
					confirmButtonColor: 'var(--primary)',
				})
			}
		}

		if ($button.dataset.action === 'delete') {
			const confirm = await Swal.fire({
				title: `¿Eliminar "${slug}"?`,
				text: 'Esta acción no se puede deshacer.',
				icon: 'warning',
				showCancelButton: true,
				confirmButtonText: 'Eliminar',
				cancelButtonText: 'Cancelar',
				confirmButtonColor: '#444',
			})

			if (!confirm.isConfirmed) return

			try {
				await deleteDoc(doc(db, 'projects', slug))
				document.querySelector(`tr[data-row-slug="${slug}"]`)?.remove()
				Swal.fire({
					title: 'Proyecto eliminado.',
					icon: 'success',
					confirmButtonColor: 'var(--secondary)',
				})
			} catch (err) {
				Swal.fire({
					title: 'Error al eliminar el proyecto.',
					icon: 'error',
					confirmButtonColor: 'var(--primary)',
				})
			}
		}
	})

	$form.addEventListener('submit', async e => {
		e.preventDefault()

		const fd = new FormData($form)
		const slug = String(fd.get('slug') ?? '').trim()
		const stacks = String(fd.get('stacks') ?? '')
			.split(',')
			.map(stack => stack.trim())
			.filter(Boolean)

		if (!fd.get('mockup') || !fd.get('image')) {
			Swal.fire({
				title: 'Faltan imágenes',
				text: 'Sube la miniatura y la imagen de detalle antes de guardar.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			return
		}

		$submitBtn.disabled = true
		$submitBtn.textContent = 'Guardando...'

		try {
			await setDoc(doc(collection(db, 'projects'), slug), {
				title: fd.get('title'),
				mockup: fd.get('mockup'),
				image: fd.get('image'),
				stacks,
				description: descriptionQuill.root.innerHTML,
				gallery: galleryUrls,
				url: fd.get('url') || null,
				github: fd.get('github') || null,
				draft: $draftInput.checked,
			}, { merge: true })

			closeModal()
			await Swal.fire({
				title: mode === 'create' ? 'Proyecto creado.' : 'Proyecto actualizado.',
				icon: 'success',
				confirmButtonColor: 'var(--secondary)',
			})
			window.location.reload()
		} catch (err) {
			Swal.fire({
				title: 'Error al guardar el proyecto.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
		} finally {
			$submitBtn.disabled = false
			$submitBtn.textContent = 'Guardar'
		}
	})
</script>
