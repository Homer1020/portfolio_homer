---
import AdminLayout from '../../layouts/AdminLayout.astro'

import { getFirestore } from 'firebase-admin/firestore';

const db = getFirestore();

const [testimoniosSnap, proyectosSnap, visitasSnap, visitasSnapshot] = await Promise.all([
  db.collection('testimonials').where('published', '==', false).count().get(),
  db.collection('projects').count().get(),
  db.collection('analytics').count().get(),
  db.collection('analytics').orderBy('fecha', 'desc').limit(10).get()
]);

const totalTestimonios = testimoniosSnap.data().count;
const totalProyectos = proyectosSnap.data().count;
const totalVisitas = visitasSnap.data().count;

const stats = [
	{ label: 'Proyectos', value: totalProyectos },
	{ label: 'Testimonios pendientes', value: totalTestimonios },
	{ label: 'Visitas totales', value: totalVisitas },
]

const visitas = visitasSnapshot.docs.map(doc => {
	const data = doc.data();
	const fecha = data.fecha?.toDate ? data.fecha.toDate() : null;
	return {
		id: doc.id,
		fecha: fecha ? fecha.toLocaleString('es-VE') : '-',
		ip: data.ip || '-',
		pais: data.pais || '-',
		ruta: data.ruta || '-',
		referrer: data.referrer || '-',
		userAgent: data.userAgent || '-',
	};
});
---

<AdminLayout title="Dashboard">
	<div class="admin-stats">
		{stats.map(stat => (
			<div class="admin-card">
				<span class="admin-card__label">{stat.label}</span>
				<strong class="admin-card__value">{stat.value}</strong>
			</div>
		))}
	</div>

	<div class="admin-toolbar">
		<h2>Últimas visitas</h2>
	</div>

	<div class="admin-table-wrapper">
		<table class="admin-table">
			<thead>
				<tr>
					<th>Fecha</th>
					<th>IP</th>
					<th>País</th>
					<th>Ruta</th>
					<th>Referrer</th>
					<th>User Agent</th>
				</tr>
			</thead>
			<tbody>
				{visitas.length === 0 && (
					<tr><td colspan="6" class="admin-table__empty-state">Sin visitas registradas.</td></tr>
				)}
				{visitas.map(visita => (
					<tr>
						<td>{visita.fecha}</td>
						<td>{visita.ip}</td>
						<td>{visita.pais}</td>
						<td>{visita.ruta}</td>
						<td class="admin-table__truncate" title={visita.referrer}>{visita.referrer}</td>
						<td class="admin-table__truncate" title={visita.userAgent}>{visita.userAgent}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
</AdminLayout>

<style>
	.admin-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.5rem;
	}

	.admin-card__label {
		display: block;
		font-size: 1.3rem;
		color: #6b7280;
		margin-bottom: .5rem;
	}

	.admin-card__value {
		font-size: 2.4rem;
	}

	.admin-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin: 2.5rem 0 2rem;

		h2 {
			font-size: 2.2rem;
		}
	}

	.admin-table-wrapper {
		background-color: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 10px;
		overflow-x: auto;
	}

	.admin-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 1.4rem;

		th, td {
			text-align: left;
			padding: 1.2rem 1.5rem;
			white-space: nowrap;
		}

		thead th {
			background-color: #f8f9fa;
			color: #6b7280;
			font-weight: 600;
			border-bottom: 1px solid #e5e7eb;
		}

		tbody tr:not(:last-child) td {
			border-bottom: 1px solid #f1f3f5;
		}
	}

	.admin-table__truncate {
		max-width: 260px;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.admin-table__empty-state {
		text-align: center;
		color: #9ca3af;
		padding: 3rem;
	}
</style>

<script>
  import { getAuth, signOut } from "firebase/auth";
  import { app } from "../../config/firebase"; // Tu config de Firebase cliente

  const logoutBtn = document.getElementById("logout-btn");

  logoutBtn?.addEventListener("click", async () => {
    try {
      const auth = getAuth(app);
      
      // 1. Cerrar sesión en la SDK del cliente (borra IndexedDB/LocalStorage)
      await signOut(auth);

      // 2. Destruir la cookie del servidor en Astro
      await fetch("/api/auth/signout", { method: "POST" });

      // 3. Redirigir al login
      window.location.href = "/admin/login";
    } catch (error) {
      console.error("Error al cerrar sesión:", error);
    }
  });
</script>