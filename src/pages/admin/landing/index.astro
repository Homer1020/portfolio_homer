<script>
	import Swal from 'sweetalert2'

	const $input = document.getElementById('cv-input') as HTMLInputElement
	const $label = document.getElementById('cv-upload-label') as HTMLElement

	$input.addEventListener('change', async () => {
		const file = $input.files?.[0]
		if (!file) return

		const originalLabel = $label.textContent

		if (file.type !== 'application/pdf') {
			Swal.fire({
				title: 'Archivo inválido',
				text: 'Solo se permiten archivos PDF.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			$input.value = ''
			return
		}

		if (file.size > 10e6) {
			Swal.fire({
				title: 'Archivo muy pesado',
				text: 'El PDF debe pesar 10mb o menos.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			$input.value = ''
			return
		}

		$label.textContent = 'Subiendo...'
		$input.disabled = true

		try {
			const fd = new FormData()
			fd.append('file', file)

			const res = await fetch('/api/admin/upload-cv', { method: 'POST', body: fd })
			if (!res.ok) throw new Error(await res.text())

			await Swal.fire({
				title: 'CV actualizado.',
				icon: 'success',
				confirmButtonColor: 'var(--secondary)',
			})
			window.location.reload()
		} catch (err) {
			Swal.fire({
				title: 'Error al subir el CV.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			$label.textContent = originalLabel
			$input.disabled = false
			$input.value = ''
		}
	})
</script>

<script>
	import Quill from 'quill'
	import 'quill/dist/quill.snow.css'
	import { doc, setDoc } from 'firebase/firestore'
	import { db } from '../../../config/firebase'
	import Swal from 'sweetalert2'

	const landing = (window as any).__LANDING__ ?? { hero: {}, about: {} }
	const toolbarOptions = ['bold', 'italic', 'underline', 'link']

	const PRESET_ICONS = [
		{ label: 'LinkedIn', icon: 'fab fa-linkedin' },
		{ label: 'GitHub', icon: 'fab fa-github' },
		{ label: 'CodePen', icon: 'fab fa-codepen' },
		{ label: 'X / Twitter', icon: 'fab fa-x-twitter' },
		{ label: 'Instagram', icon: 'fab fa-instagram' },
		{ label: 'YouTube', icon: 'fab fa-youtube' },
		{ label: 'Discord', icon: 'fab fa-discord' },
		{ label: 'Twitch', icon: 'fab fa-twitch' },
		{ label: 'WhatsApp', icon: 'fab fa-whatsapp' },
		{ label: 'Telegram', icon: 'fab fa-telegram' },
		{ label: 'GitLab', icon: 'fab fa-gitlab' },
		{ label: 'Email', icon: 'fas fa-envelope' },
		{ label: 'Web / Sitio', icon: 'fas fa-globe' },
		{ label: 'Personalizado...', icon: 'custom' },
	]

	const openModal = (modal: HTMLElement) => {
		modal.classList.add('open')
		document.body.style.overflow = 'hidden'
	}

	const closeModal = (modal: HTMLElement) => {
		modal.classList.remove('open')
		document.body.style.overflow = ''
	}

	// --- Hero Elements ---
	const $heroModal = document.getElementById('hero-modal') as HTMLElement
	const $editHeroBtn = document.getElementById('edit-hero-btn') as HTMLElement
	const $closeHeroModal = document.getElementById('close-hero-modal') as HTMLElement
	const $formHero = document.getElementById('form-hero') as HTMLFormElement
	const $heroBadge = document.getElementById('hero-badge') as HTMLInputElement
	const $heroTitle = document.getElementById('hero-title') as HTMLInputElement
	const $submitHeroBtn = document.getElementById('submit-hero-btn') as HTMLButtonElement

	// Avatar elements
	const $heroAvatarPreview = document.getElementById('hero-avatar-preview') as HTMLElement
	const $heroImageInput = document.getElementById('hero-image-input') as HTMLInputElement
	const $heroImageLabel = document.getElementById('hero-image-label') as HTMLElement
	const $heroImageReset = document.getElementById('hero-image-reset') as HTMLButtonElement
	const $heroImageUrl = document.getElementById('hero-image-url') as HTMLInputElement
	const $heroImageHidden = document.getElementById('hero-image-hidden') as HTMLInputElement

	// Social links elements
	const $socialLinksList = document.getElementById('social-links-list') as HTMLElement
	const $addSocialLinkBtn = document.getElementById('add-social-link-btn') as HTMLButtonElement

	const heroSubtitleQuill = new Quill('#hero-subtitle-editor', {
		theme: 'snow',
		modules: { toolbar: toolbarOptions },
	})

	let currentSocialLinks: Array<{ label: string; url: string; icon: string }> = []

	function updateAvatarDisplay(url: string) {
		$heroImageHidden.value = url
		$heroImageUrl.value = url
		if (url) {
			$heroAvatarPreview.style.backgroundImage = `url('${url}')`
		} else {
			$heroAvatarPreview.style.backgroundImage = `url('/assets/img/homer_04.jpeg')`
		}
	}

	// Avatar upload
	$heroImageInput.addEventListener('change', async () => {
		const file = $heroImageInput.files?.[0]
		if (!file) return

		const originalLabel = $heroImageLabel.innerHTML
		$heroImageLabel.innerHTML = '<span>Subiendo...</span>'
		$heroImageInput.disabled = true

		try {
			const fd = new FormData()
			fd.append('file', file)
			fd.append('folder', 'hero')

			const res = await fetch('/api/admin/upload-image', { method: 'POST', body: fd })
			if (!res.ok) throw new Error(await res.text())

			const data = await res.json()
			updateAvatarDisplay(data.url)
			Swal.fire({
				icon: 'success',
				title: 'Foto subida',
				text: 'La foto se subió correctamente. Recuerda presionar "Guardar Cambios".',
				timer: 2000,
				showConfirmButton: false,
			})
		} catch (err) {
			console.error(err)
			Swal.fire({
				icon: 'error',
				title: 'Error al subir la imagen',
				confirmButtonColor: 'var(--primary)',
			})
		} finally {
			$heroImageLabel.innerHTML = originalLabel
			$heroImageInput.disabled = false
			$heroImageInput.value = ''
		}
	})

	$heroImageUrl.addEventListener('input', () => {
		updateAvatarDisplay($heroImageUrl.value.trim())
	})

	$heroImageReset.addEventListener('click', () => {
		updateAvatarDisplay('')
	})

	// Render social links
	function renderSocialLinks() {
		$socialLinksList.innerHTML = ''

		if (currentSocialLinks.length === 0) {
			$socialLinksList.innerHTML = '<p class="section-hint" style="text-align: center; padding: 1rem;">No hay enlaces agregados aún.</p>'
			return
		}

		currentSocialLinks.forEach((link, index) => {
			const row = document.createElement('div')
			row.className = 'social-link-row'

			const isCustom = !PRESET_ICONS.some(p => p.icon === link.icon && p.icon !== 'custom')
			const selectedValue = isCustom ? 'custom' : link.icon

			let optionsHtml = PRESET_ICONS.map(p => `
				<option value="${p.icon}" ${p.icon === selectedValue ? 'selected' : ''}>${p.label}</option>
			`).join('')

			row.innerHTML = `
				<div class="social-link-icon-box" id="icon-box-${index}">
					<i class="${link.icon || 'fas fa-link'}"></i>
				</div>
				<select class="social-link-icon-select" data-index="${index}">
					${optionsHtml}
				</select>
				<input
					type="text"
					class="social-link-custom-icon"
					data-index="${index}"
					placeholder="Clase fa (ej: fab fa-gitlab)"
					value="${link.icon}"
					style="display: ${selectedValue === 'custom' ? 'block' : 'none'};"
				/>
				<input
					type="text"
					class="social-link-input-label"
					data-index="${index}"
					placeholder="Nombre (ej: LinkedIn)"
					value="${link.label || ''}"
					required
				/>
				<input
					type="url"
					class="social-link-input-url"
					data-index="${index}"
					placeholder="URL (ej: https://...)"
					value="${link.url || ''}"
					required
				/>
				<button type="button" class="social-link-remove-btn" data-index="${index}" title="Eliminar enlace">
					<i class="fa fa-trash"></i>
				</button>
			`

			$socialLinksList.appendChild(row)
		})

		// Attach events
		$socialLinksList.querySelectorAll('.social-link-icon-select').forEach((select) => {
			select.addEventListener('change', (e) => {
				const target = e.target as HTMLSelectElement
				const idx = parseInt(target.getAttribute('data-index') || '0', 10)
				const row = target.closest('.social-link-row')
				const customInput = row?.querySelector('.social-link-custom-icon') as HTMLInputElement
				const iconBox = row?.querySelector('.social-link-icon-box i') as HTMLElement
				const labelInput = row?.querySelector('.social-link-input-label') as HTMLInputElement

				if (target.value === 'custom') {
					customInput.style.display = 'block'
					currentSocialLinks[idx].icon = customInput.value || 'fas fa-link'
					if (iconBox) iconBox.className = currentSocialLinks[idx].icon
				} else {
					customInput.style.display = 'none'
					currentSocialLinks[idx].icon = target.value
					customInput.value = target.value
					if (iconBox) iconBox.className = target.value

					// If label is empty, suggest preset name
					const preset = PRESET_ICONS.find(p => p.icon === target.value)
					if (preset && !labelInput.value) {
						labelInput.value = preset.label.replace(' / Sitio', '').replace(' / Twitter', '')
						currentSocialLinks[idx].label = labelInput.value
					}
				}
			})
		})

		$socialLinksList.querySelectorAll('.social-link-custom-icon').forEach((input) => {
			input.addEventListener('input', (e) => {
				const target = e.target as HTMLInputElement
				const idx = parseInt(target.getAttribute('data-index') || '0', 10)
				const row = target.closest('.social-link-row')
				const iconBox = row?.querySelector('.social-link-icon-box i') as HTMLElement
				currentSocialLinks[idx].icon = target.value.trim() || 'fas fa-link'
				if (iconBox) iconBox.className = currentSocialLinks[idx].icon
			})
		})

		$socialLinksList.querySelectorAll('.social-link-input-label').forEach((input) => {
			input.addEventListener('input', (e) => {
				const target = e.target as HTMLInputElement
				const idx = parseInt(target.getAttribute('data-index') || '0', 10)
				currentSocialLinks[idx].label = target.value
			})
		})

		$socialLinksList.querySelectorAll('.social-link-input-url').forEach((input) => {
			input.addEventListener('input', (e) => {
				const target = e.target as HTMLInputElement
				const idx = parseInt(target.getAttribute('data-index') || '0', 10)
				currentSocialLinks[idx].url = target.value
			})
		})

		$socialLinksList.querySelectorAll('.social-link-remove-btn').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				const target = (e.target as HTMLElement).closest('.social-link-remove-btn') as HTMLElement
				const idx = parseInt(target.getAttribute('data-index') || '0', 10)
				currentSocialLinks.splice(idx, 1)
				renderSocialLinks()
			})
		})
	}

	$addSocialLinkBtn.addEventListener('click', () => {
		currentSocialLinks.push({
			label: 'GitHub',
			url: 'https://github.com/',
			icon: 'fab fa-github',
		})
		renderSocialLinks()
	})

	$editHeroBtn.addEventListener('click', () => {
		$heroBadge.value = landing.hero?.badge ?? ''
		$heroTitle.value = landing.hero?.title ?? ''
		updateAvatarDisplay(landing.hero?.image ?? '')
		heroSubtitleQuill.setText('')
		heroSubtitleQuill.clipboard.dangerouslyPasteHTML(landing.hero?.subtitleHtml ?? '')

		// Clone social links array
		currentSocialLinks = JSON.parse(JSON.stringify(landing.hero?.socialLinks ?? []))
		renderSocialLinks()

		openModal($heroModal)
	})

	$closeHeroModal.addEventListener('click', () => closeModal($heroModal))
	$heroModal.addEventListener('click', e => {
		if (e.target === $heroModal) closeModal($heroModal)
	})

	$formHero.addEventListener('submit', async e => {
		e.preventDefault()
		$submitHeroBtn.disabled = true
		$submitHeroBtn.textContent = 'Guardando...'

		try {
			const payload = {
				hero: {
					badge: $heroBadge.value.trim(),
					title: $heroTitle.value.trim(),
					subtitleHtml: heroSubtitleQuill.root.innerHTML,
					image: $heroImageHidden.value.trim(),
					socialLinks: currentSocialLinks.filter(l => l.url.trim() !== '' && l.label.trim() !== ''),
				},
			}
			await setDoc(doc(db, 'landing', 'content'), payload, { merge: true })
			landing.hero = payload.hero
			closeModal($heroModal)
			await Swal.fire({
				title: 'Hero actualizado.',
				icon: 'success',
				confirmButtonColor: 'var(--secondary)',
			})
			window.location.reload()
		} catch (err) {
			console.error(err)
			Swal.fire({
				title: 'Error al guardar el hero.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
		} finally {
			$submitHeroBtn.disabled = false
			$submitHeroBtn.textContent = 'Guardar Cambios'
		}
	})

	// --- Sobre mí ---
	const $aboutModal = document.getElementById('about-modal') as HTMLElement
	const $editAboutBtn = document.getElementById('edit-about-btn') as HTMLElement
	const $closeAboutModal = document.getElementById('close-about-modal') as HTMLElement
	const $formAbout = document.getElementById('form-about') as HTMLFormElement
	const $aboutBadge = document.getElementById('about-badge') as HTMLInputElement
	const $aboutTitle = document.getElementById('about-title') as HTMLInputElement
	const $submitAboutBtn = document.getElementById('submit-about-btn') as HTMLButtonElement

	const aboutBodyQuill = new Quill('#about-body-editor', {
		theme: 'snow',
		modules: { toolbar: toolbarOptions },
	})

	$editAboutBtn.addEventListener('click', () => {
		$aboutBadge.value = landing.about?.badge ?? ''
		$aboutTitle.value = landing.about?.title ?? ''
		aboutBodyQuill.setText('')
		aboutBodyQuill.clipboard.dangerouslyPasteHTML(landing.about?.bodyHtml ?? '')
		openModal($aboutModal)
	})

	$closeAboutModal.addEventListener('click', () => closeModal($aboutModal))
	$aboutModal.addEventListener('click', e => {
		if (e.target === $aboutModal) closeModal($aboutModal)
	})

	$formAbout.addEventListener('submit', async e => {
		e.preventDefault()
		$submitAboutBtn.disabled = true
		$submitAboutBtn.textContent = 'Guardando...'

		try {
			const payload = {
				about: {
					badge: $aboutBadge.value,
					title: $aboutTitle.value,
					bodyHtml: aboutBodyQuill.root.innerHTML,
				},
			}
			await setDoc(doc(db, 'landing', 'content'), payload, { merge: true })
			landing.about = payload.about
			closeModal($aboutModal)
			await Swal.fire({
				title: 'Sección actualizada.',
				icon: 'success',
				confirmButtonColor: 'var(--secondary)',
			})
			window.location.reload()
		} catch (err) {
			Swal.fire({
				title: 'Error al guardar la sección.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
		} finally {
			$submitAboutBtn.disabled = false
			$submitAboutBtn.textContent = 'Guardar'
		}
	})
</script>
