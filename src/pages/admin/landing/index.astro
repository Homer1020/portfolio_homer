---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import Input from '../../../components/Form/Input.astro'
import { getFirestore } from 'firebase-admin/firestore'
import type { HeroContent, AboutContent } from '../../../types'

const db = getFirestore()

const landingSnap = await db.collection('landing').doc('content').get()
const landingData = landingSnap.data() ?? {}

const cvUrl: string = landingData.cvUrl ?? ''
const cvFileName: string = landingData.cvFileName ?? ''
const cvUpdatedAt = landingData.cvUpdatedAt?.toDate
	? landingData.cvUpdatedAt.toDate().toLocaleString('es-VE')
	: ''

const hero: HeroContent = {
	badge: landingData.hero?.badge || 'Hola! yo soy',
	title: landingData.hero?.title || 'Homer Moncayo',
	subtitleHtml: landingData.hero?.subtitleHtml || 'Un competente <strong>Programador web FullStack</strong>, apacionado por el mundo del software y con más de 5 años de experiencia.',
}

const about: AboutContent = {
	badge: landingData.about?.badge || 'Sobre mi',
	title: landingData.about?.title || 'Un creador de software limpio, moderno y escalable para la web y móviles.',
	bodyHtml: landingData.about?.bodyHtml || '<p>Soy un programador web FullStack especializado en el área del FrontEnd. Incursioné en el mundo de la programación a los 16 años de edad y quedé fascinado. Mi capacidad para entender y resolver temas complejos me ayudó a convertirme en un programador competente a día de hoy.</p><p>Soy un experto en la creación de interfaces de usuario intuitivas, adaptables a dispositivos y amigables al SEO. Me destaco por brindar servicios de calidad y poner esmero en mis desarrollos. Soy muy comprometido con mi trabajo y trato de dar un esfuerzo adicional en cada proyecto que emprendo.</p>',
}
---

<AdminLayout title="Landing">
	<div class="admin-toolbar">
		<h2>Landing</h2>
	</div>

	<div class="admin-modules">
		<div class="admin-card admin-card--module">
			<div class="admin-card__header">
				<h3>Currículum (CV)</h3>
				<p>PDF que se ofrece para descargar desde la landing.</p>
			</div>

			<div class="cv-status" id="cv-status">
				{cvUrl
					? <a href={cvUrl} target="_blank" rel="noopener">{cvFileName || 'Ver CV actual'}</a>
					: <span class="cv-status__empty">Sin CV subido aún.</span>}
				{cvUpdatedAt && <small>Actualizado: {cvUpdatedAt}</small>}
			</div>

			<label class="button button--secondary-o button--sm" for="cv-input" id="cv-upload-label">
				{cvUrl ? 'Reemplazar CV' : 'Subir CV'}
			</label>
			<input type="file" id="cv-input" accept="application/pdf" hidden />
		</div>

		<div class="admin-card admin-card--module">
			<div class="admin-card__header">
				<h3>Hero</h3>
				<p>Encabezado principal que se muestra al abrir la landing.</p>
			</div>
			<button type="button" class="button button--secondary-o button--sm" id="edit-hero-btn">Editar</button>
		</div>

		<div class="admin-card admin-card--module">
			<div class="admin-card__header">
				<h3>Sobre mí</h3>
				<p>Texto de presentación de la sección "Sobre mí".</p>
			</div>
			<button type="button" class="button button--secondary-o button--sm" id="edit-about-btn">Editar</button>
		</div>

		<div class="admin-card admin-card--placeholder">
			<h3>Más módulos próximamente</h3>
			<p>Experiencia y Stack se podrán editar aquí.</p>
		</div>
	</div>

	<div class="admin-modal" id="hero-modal">
		<div class="admin-modal__content">
			<button type="button" class="admin-modal__close" id="close-hero-modal">
				<i class="fa fa-times"></i>
			</button>
			<h2>Editar Hero</h2>
			<form id="form-hero">
				<Input type="text" id="hero-badge" label="Etiqueta" placeholder="Hola! yo soy" required />
				<Input type="text" id="hero-title" label="Título" placeholder="Homer Moncayo" required />
				<div class="editor-group">
					<label class="editor-label">Subtítulo</label>
					<div id="hero-subtitle-editor" class="wysiwyg"></div>
				</div>
				<div class="admin-modal__actions">
					<button type="submit" class="button button--primary" id="submit-hero-btn">Guardar</button>
				</div>
			</form>
		</div>
	</div>

	<div class="admin-modal" id="about-modal">
		<div class="admin-modal__content">
			<button type="button" class="admin-modal__close" id="close-about-modal">
				<i class="fa fa-times"></i>
			</button>
			<h2>Editar Sobre mí</h2>
			<form id="form-about">
				<Input type="text" id="about-badge" label="Etiqueta" placeholder="Sobre mi" required />
				<Input type="text" id="about-title" label="Título" placeholder="Un creador de software..." required />
				<div class="editor-group">
					<label class="editor-label">Texto (un párrafo por línea)</label>
					<div id="about-body-editor" class="wysiwyg"></div>
				</div>
				<div class="admin-modal__actions">
					<button type="submit" class="button button--primary" id="submit-about-btn">Guardar</button>
				</div>
			</form>
		</div>
	</div>
</AdminLayout>

<script define:vars={{ hero, about }} is:inline>
	window.__LANDING__ = { hero, about }
</script>

<style lang="scss">
	@use '../../../styles/mixins/theme' as theme;

	.admin-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;

		h2 {
			font-size: 2.2rem;
		}
	}

	.admin-modules {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.admin-card {
		@include theme.theme-property('background-color', 'sectionBg');
		@include theme.theme-property('border', 'figureBorder');
		border-radius: 10px;
		padding: 2rem;
	}

	.admin-card--module h3 {
		font-size: 1.8rem;
		margin-bottom: .3rem;
	}

	.admin-card__header p {
		font-size: 1.3rem;
		@include theme.theme-property('color', 'legendText');
		margin-bottom: 1.5rem;
	}

	.cv-status {
		display: flex;
		flex-direction: column;
		gap: .3rem;
		margin-bottom: 1.5rem;
		font-size: 1.4rem;

		a {
			color: var(--primary);
			font-weight: 500;
			word-break: break-all;
		}

		small {
			@include theme.theme-property('color', 'legendText');
			font-size: 1.2rem;
		}
	}

	.cv-status__empty {
		@include theme.theme-property('color', 'legendText');
	}

	.admin-card--module {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.editor-group {
		margin-bottom: 1.5rem;
	}

	.editor-label {
		display: block;
		margin-bottom: .75rem;
		font-size: 1.4rem;
		font-weight: 500;
		font-family: "Poppins", sans-serif;
	}

	.wysiwyg {
		@include theme.theme-property('background-color', 'sectionBg');
		font-size: 1.4rem;
	}

	.wysiwyg :global(.ql-toolbar) {
		border-radius: 5px 5px 0 0;
		@include theme.theme-property('border', 'figureBorder');
	}

	.wysiwyg :global(.ql-container) {
		border-radius: 0 0 5px 5px;
		font-family: inherit;
		@include theme.theme-property('border', 'figureBorder');
		@include theme.theme-property('color', 'articleText');
	}

	.wysiwyg :global(.ql-editor) {
		min-height: 120px;
	}

	.wysiwyg :global(.ql-editor.ql-blank::before) {
		@include theme.theme-property('color', 'legendText');
	}

	.wysiwyg :global(.ql-stroke) {
		@include theme.theme-property('stroke', 'legendText');
	}

	.wysiwyg :global(.ql-fill) {
		@include theme.theme-property('fill', 'legendText');
	}

	.wysiwyg :global(.ql-picker) {
		@include theme.theme-property('color', 'legendText');
	}

	.wysiwyg :global(.ql-picker-options) {
		@include theme.theme-property('background-color', 'sectionBg');
		@include theme.theme-property('border', 'figureBorder');
	}

	.admin-card--placeholder {
		display: flex;
		flex-direction: column;
		justify-content: center;
		@include theme.theme-property('color', 'legendText');
		border-style: dashed;

		h3 {
			font-size: 1.6rem;
			@include theme.theme-property('color', 'legendText');
			margin-bottom: .3rem;
		}

		p {
			font-size: 1.3rem;
		}
	}

	.admin-modal {
		display: none;
		position: fixed;
		inset: 0;
		@include theme.theme-property('background-color', 'modalBg');
		align-items: center;
		justify-content: center;
		padding: 2rem;
		z-index: 100;
	}

	.admin-modal.open {
		display: flex;
	}

	.admin-modal__content {
		position: relative;
		width: min(600px, 100%);
		max-height: 90vh;
		overflow-y: auto;
		@include theme.theme-property('background-color', 'sectionBg');
		border-radius: 10px;
		padding: 2.5rem;
	}

	.admin-modal__close {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		background: none;
		border: none;
		font-size: 1.8rem;
		cursor: pointer;
		@include theme.theme-property('color', 'legendText');
	}

	.admin-modal__actions {
		margin-top: 1.5rem;
	}

	.admin-modal h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
	}
</style>

<script>
	import Swal from 'sweetalert2'

	const $input = document.getElementById('cv-input') as HTMLInputElement
	const $label = document.getElementById('cv-upload-label') as HTMLElement

	$input.addEventListener('change', async () => {
		const file = $input.files?.[0]
		if (!file) return

		const originalLabel = $label.textContent

		if (file.type !== 'application/pdf') {
			Swal.fire({
				title: 'Archivo inválido',
				text: 'Solo se permiten archivos PDF.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			$input.value = ''
			return
		}

		if (file.size > 10e6) {
			Swal.fire({
				title: 'Archivo muy pesado',
				text: 'El PDF debe pesar 10mb o menos.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			$input.value = ''
			return
		}

		$label.textContent = 'Subiendo...'
		$input.disabled = true

		try {
			const fd = new FormData()
			fd.append('file', file)

			const res = await fetch('/api/admin/upload-cv', { method: 'POST', body: fd })
			if (!res.ok) throw new Error(await res.text())

			await Swal.fire({
				title: 'CV actualizado.',
				icon: 'success',
				confirmButtonColor: 'var(--secondary)',
			})
			window.location.reload()
		} catch (err) {
			Swal.fire({
				title: 'Error al subir el CV.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			$label.textContent = originalLabel
			$input.disabled = false
			$input.value = ''
		}
	})
</script>

<script>
	import Quill from 'quill'
	import 'quill/dist/quill.snow.css'
	import { doc, setDoc } from 'firebase/firestore'
	import { db } from '../../../config/firebase'
	import Swal from 'sweetalert2'

	const landing = (window as any).__LANDING__ ?? { hero: {}, about: {} }
	const toolbarOptions = ['bold', 'italic', 'underline', 'link']

	const openModal = (modal: HTMLElement) => {
		modal.classList.add('open')
		document.body.style.overflow = 'hidden'
	}

	const closeModal = (modal: HTMLElement) => {
		modal.classList.remove('open')
		document.body.style.overflow = ''
	}

	// --- Hero ---
	const $heroModal = document.getElementById('hero-modal') as HTMLElement
	const $editHeroBtn = document.getElementById('edit-hero-btn') as HTMLElement
	const $closeHeroModal = document.getElementById('close-hero-modal') as HTMLElement
	const $formHero = document.getElementById('form-hero') as HTMLFormElement
	const $heroBadge = document.getElementById('hero-badge') as HTMLInputElement
	const $heroTitle = document.getElementById('hero-title') as HTMLInputElement
	const $submitHeroBtn = document.getElementById('submit-hero-btn') as HTMLButtonElement

	const heroSubtitleQuill = new Quill('#hero-subtitle-editor', {
		theme: 'snow',
		modules: { toolbar: toolbarOptions },
	})

	$editHeroBtn.addEventListener('click', () => {
		$heroBadge.value = landing.hero?.badge ?? ''
		$heroTitle.value = landing.hero?.title ?? ''
		heroSubtitleQuill.setText('')
		heroSubtitleQuill.clipboard.dangerouslyPasteHTML(landing.hero?.subtitleHtml ?? '')
		openModal($heroModal)
	})

	$closeHeroModal.addEventListener('click', () => closeModal($heroModal))
	$heroModal.addEventListener('click', e => {
		if (e.target === $heroModal) closeModal($heroModal)
	})

	$formHero.addEventListener('submit', async e => {
		e.preventDefault()
		$submitHeroBtn.disabled = true
		$submitHeroBtn.textContent = 'Guardando...'

		try {
			const payload = {
				hero: {
					badge: $heroBadge.value,
					title: $heroTitle.value,
					subtitleHtml: heroSubtitleQuill.root.innerHTML,
				},
			}
			await setDoc(doc(db, 'landing', 'content'), payload, { merge: true })
			landing.hero = payload.hero
			closeModal($heroModal)
			await Swal.fire({
				title: 'Hero actualizado.',
				icon: 'success',
				confirmButtonColor: 'var(--secondary)',
			})
			window.location.reload()
		} catch (err) {
			Swal.fire({
				title: 'Error al guardar el hero.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
		} finally {
			$submitHeroBtn.disabled = false
			$submitHeroBtn.textContent = 'Guardar'
		}
	})

	// --- Sobre mí ---
	const $aboutModal = document.getElementById('about-modal') as HTMLElement
	const $editAboutBtn = document.getElementById('edit-about-btn') as HTMLElement
	const $closeAboutModal = document.getElementById('close-about-modal') as HTMLElement
	const $formAbout = document.getElementById('form-about') as HTMLFormElement
	const $aboutBadge = document.getElementById('about-badge') as HTMLInputElement
	const $aboutTitle = document.getElementById('about-title') as HTMLInputElement
	const $submitAboutBtn = document.getElementById('submit-about-btn') as HTMLButtonElement

	const aboutBodyQuill = new Quill('#about-body-editor', {
		theme: 'snow',
		modules: { toolbar: toolbarOptions },
	})

	$editAboutBtn.addEventListener('click', () => {
		$aboutBadge.value = landing.about?.badge ?? ''
		$aboutTitle.value = landing.about?.title ?? ''
		aboutBodyQuill.setText('')
		aboutBodyQuill.clipboard.dangerouslyPasteHTML(landing.about?.bodyHtml ?? '')
		openModal($aboutModal)
	})

	$closeAboutModal.addEventListener('click', () => closeModal($aboutModal))
	$aboutModal.addEventListener('click', e => {
		if (e.target === $aboutModal) closeModal($aboutModal)
	})

	$formAbout.addEventListener('submit', async e => {
		e.preventDefault()
		$submitAboutBtn.disabled = true
		$submitAboutBtn.textContent = 'Guardando...'

		try {
			const payload = {
				about: {
					badge: $aboutBadge.value,
					title: $aboutTitle.value,
					bodyHtml: aboutBodyQuill.root.innerHTML,
				},
			}
			await setDoc(doc(db, 'landing', 'content'), payload, { merge: true })
			landing.about = payload.about
			closeModal($aboutModal)
			await Swal.fire({
				title: 'Sección actualizada.',
				icon: 'success',
				confirmButtonColor: 'var(--secondary)',
			})
			window.location.reload()
		} catch (err) {
			Swal.fire({
				title: 'Error al guardar la sección.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
		} finally {
			$submitAboutBtn.disabled = false
			$submitAboutBtn.textContent = 'Guardar'
		}
	})
</script>
