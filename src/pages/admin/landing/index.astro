---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { getFirestore } from 'firebase-admin/firestore'

const db = getFirestore()

const landingSnap = await db.collection('landing').doc('content').get()
const landingData = landingSnap.data() ?? {}

const cvUrl: string = landingData.cvUrl ?? ''
const cvFileName: string = landingData.cvFileName ?? ''
const cvUpdatedAt = landingData.cvUpdatedAt?.toDate
	? landingData.cvUpdatedAt.toDate().toLocaleString('es-VE')
	: ''
---

<AdminLayout title="Landing">
	<div class="admin-toolbar">
		<h2>Landing</h2>
	</div>

	<div class="admin-modules">
		<div class="admin-card admin-card--module">
			<div class="admin-card__header">
				<h3>Currículum (CV)</h3>
				<p>PDF que se ofrece para descargar desde la landing.</p>
			</div>

			<div class="cv-status" id="cv-status">
				{cvUrl
					? <a href={cvUrl} target="_blank" rel="noopener">{cvFileName || 'Ver CV actual'}</a>
					: <span class="cv-status__empty">Sin CV subido aún.</span>}
				{cvUpdatedAt && <small>Actualizado: {cvUpdatedAt}</small>}
			</div>

			<label class="button button--secondary-o button--sm" for="cv-input" id="cv-upload-label">
				{cvUrl ? 'Reemplazar CV' : 'Subir CV'}
			</label>
			<input type="file" id="cv-input" accept="application/pdf" hidden />
		</div>

		<div class="admin-card admin-card--placeholder">
			<h3>Más módulos próximamente</h3>
			<p>Hero, Sobre mí, Experiencia y Stack se podrán editar aquí.</p>
		</div>
	</div>
</AdminLayout>

<style>
	.admin-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;

		h2 {
			font-size: 2.2rem;
		}
	}

	.admin-modules {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.admin-card {
		background-color: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 10px;
		padding: 2rem;
	}

	.admin-card--module h3 {
		font-size: 1.8rem;
		margin-bottom: .3rem;
	}

	.admin-card__header p {
		font-size: 1.3rem;
		color: #6b7280;
		margin-bottom: 1.5rem;
	}

	.cv-status {
		display: flex;
		flex-direction: column;
		gap: .3rem;
		margin-bottom: 1.5rem;
		font-size: 1.4rem;

		a {
			color: var(--primary);
			font-weight: 500;
			word-break: break-all;
		}

		small {
			color: #9ca3af;
			font-size: 1.2rem;
		}
	}

	.cv-status__empty {
		color: #9ca3af;
	}

	.admin-card--placeholder {
		display: flex;
		flex-direction: column;
		justify-content: center;
		color: #9ca3af;
		border-style: dashed;

		h3 {
			font-size: 1.6rem;
			color: #6b7280;
			margin-bottom: .3rem;
		}

		p {
			font-size: 1.3rem;
		}
	}
</style>

<script>
	import Swal from 'sweetalert2'

	const $input = document.getElementById('cv-input') as HTMLInputElement
	const $label = document.getElementById('cv-upload-label') as HTMLElement

	$input.addEventListener('change', async () => {
		const file = $input.files?.[0]
		if (!file) return

		const originalLabel = $label.textContent

		if (file.type !== 'application/pdf') {
			Swal.fire({
				title: 'Archivo inválido',
				text: 'Solo se permiten archivos PDF.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			$input.value = ''
			return
		}

		if (file.size > 10e6) {
			Swal.fire({
				title: 'Archivo muy pesado',
				text: 'El PDF debe pesar 10mb o menos.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			$input.value = ''
			return
		}

		$label.textContent = 'Subiendo...'
		$input.disabled = true

		try {
			const fd = new FormData()
			fd.append('file', file)

			const res = await fetch('/api/admin/upload-cv', { method: 'POST', body: fd })
			if (!res.ok) throw new Error(await res.text())

			await Swal.fire({
				title: 'CV actualizado.',
				icon: 'success',
				confirmButtonColor: 'var(--secondary)',
			})
			window.location.reload()
		} catch (err) {
			Swal.fire({
				title: 'Error al subir el CV.',
				icon: 'error',
				confirmButtonColor: 'var(--primary)',
			})
			$label.textContent = originalLabel
			$input.disabled = false
			$input.value = ''
		}
	})
</script>
