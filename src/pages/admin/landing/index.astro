---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import Input from '../../../components/Form/Input.astro'
import { getFirestore } from 'firebase-admin/firestore'
import type { HeroContent, AboutContent, HeroSocialLink } from '../../../types'

const db = getFirestore()

const landingSnap = await db.collection('landing').doc('content').get()
const landingData = landingSnap.data() ?? {}

const cvUrl: string = landingData.cvUrl ?? ''
const cvFileName: string = landingData.cvFileName ?? ''
const cvUpdatedAt = landingData.cvUpdatedAt?.toDate
	? landingData.cvUpdatedAt.toDate().toLocaleString('es-VE')
	: ''

const defaultSocialLinks: HeroSocialLink[] = [
	{ label: 'LinkedIn', url: 'https://www.linkedin.com/in/homer-moncayo', icon: 'fab fa-linkedin' },
	{ label: 'GitHub', url: 'https://github.com/Homer1020/', icon: 'fab fa-github' },
	{ label: 'CodePen', url: 'https://codepen.io/homer-moncayo', icon: 'fab fa-codepen' },
]

const hero: HeroContent = {
	badge: landingData.hero?.badge || 'Hola! yo soy',
	title: landingData.hero?.title || 'Homer Moncayo',
	subtitleHtml: landingData.hero?.subtitleHtml || 'Un competente <strong>Programador web FullStack</strong>, apacionado por el mundo del software y con más de 5 años de experiencia.',
	image: landingData.hero?.image || '',
	socialLinks: landingData.hero?.socialLinks && landingData.hero.socialLinks.length > 0
		? landingData.hero.socialLinks
		: defaultSocialLinks,
}

const about: AboutContent = {
	badge: landingData.about?.badge || 'Sobre mi',
	title: landingData.about?.title || 'Un creador de software limpio, moderno y escalable para la web y móviles.',
	bodyHtml: landingData.about?.bodyHtml || '<p>Soy un programador web FullStack especializado en el área del FrontEnd. Incursioné en el mundo de la programación a los 16 años de edad y quedé fascinado. Mi capacidad para entender y resolver temas complejos me ayudó a convertirme en un programador competente a día de hoy.</p><p>Soy un experto en la creación de interfaces de usuario intuitivas, adaptables a dispositivos y amigables al SEO. Me destaco por brindar servicios de calidad y poner esmero en mis desarrollos. Soy muy comprometido con mi trabajo y trato de dar un esfuerzo adicional en cada proyecto que emprendo.</p>',
}
---

<AdminLayout title="Landing">
	<div class="admin-toolbar">
		<h2>Landing Page</h2>
	</div>

	<div class="admin-modules">
		<div class="admin-card admin-card--module">
			<div class="admin-card__header">
				<h3>Currículum (CV)</h3>
				<p>PDF que se ofrece para descargar desde la landing.</p>
			</div>

			<div class="cv-status" id="cv-status">
				{cvUrl
					? <a href={cvUrl} target="_blank" rel="noopener">{cvFileName || 'Ver CV actual'}</a>
					: <span class="cv-status__empty">Sin CV subido aún.</span>}
				{cvUpdatedAt && <small>Actualizado: {cvUpdatedAt}</small>}
			</div>

			<label class="button button--secondary-o button--sm" for="cv-input" id="cv-upload-label">
				{cvUrl ? 'Reemplazar CV' : 'Subir CV'}
			</label>
			<input type="file" id="cv-input" accept="application/pdf" hidden />
		</div>

		<div class="admin-card admin-card--module">
			<div class="admin-card__header">
				<h3>Hero (Encabezado)</h3>
				<p>Foto de perfil, títulos, presentación y enlaces a redes sociales.</p>
			</div>
			<div class="module-preview">
				<div class="module-preview__avatar" style={hero.image ? `background-image: url('${hero.image}')` : undefined}></div>
				<div class="module-preview__info">
					<strong>{hero.title}</strong>
					<small>{(hero.socialLinks ?? []).length} redes conectadas</small>
				</div>
			</div>
			<button type="button" class="button button--secondary-o button--sm" id="edit-hero-btn">Editar Hero</button>
		</div>

		<div class="admin-card admin-card--module">
			<div class="admin-card__header">
				<h3>Sobre mí</h3>
				<p>Texto de presentación de la sección "Sobre mí".</p>
			</div>
			<div class="module-preview">
				<div class="module-preview__info">
					<strong>{about.title}</strong>
				</div>
			</div>
			<button type="button" class="button button--secondary-o button--sm" id="edit-about-btn">Editar Sobre mí</button>
		</div>

		<div class="admin-card admin-card--module">
			<div class="admin-card__header">
				<h3>Stack Tecnológico</h3>
				<p>Gestiona los iconos y tecnologías que dominas en la landing.</p>
			</div>
			<a href="/admin/stacks" class="button button--primary-o button--sm">Gestionar Stacks</a>
		</div>
	</div>

	<!-- Modal Editar Hero -->
	<div class="admin-modal" id="hero-modal">
		<div class="admin-modal__content admin-modal__content--lg">
			<button type="button" class="admin-modal__close" id="close-hero-modal">
				<i class="fa fa-times"></i>
			</button>
			<h2>Editar Sección Hero</h2>
			<form id="form-hero">
				<!-- Foto de perfil -->
				<div class="hero-avatar-section">
					<label class="editor-label">Foto de perfil</label>
					<div class="hero-avatar-picker">
						<div class="hero-avatar-preview" id="hero-avatar-preview" style={hero.image ? `background-image: url('${hero.image}')` : undefined}></div>
						<div class="hero-avatar-controls">
							<div class="hero-avatar-actions">
								<label class="button button--secondary-o button--sm" for="hero-image-input" id="hero-image-label">
									<i class="fa-solid fa-cloud-arrow-up"></i>
									<span>Subir nueva foto</span>
								</label>
								<input type="file" id="hero-image-input" accept="image/*" hidden />
								<button type="button" class="button button--dark-o button--sm" id="hero-image-reset" title="Volver a la imagen por defecto">
									<i class="fa-solid fa-rotate-left"></i>
									<span>Por defecto</span>
								</button>
							</div>
							<Input
								type="url"
								id="hero-image-url"
								label="O ingresa la URL de la imagen directamente"
								placeholder="https://ejemplo.com/avatar.jpg"
								value={hero.image ?? ''}
							/>
						</div>
					</div>
					<input type="hidden" id="hero-image-hidden" value={hero.image ?? ''} />
				</div>

				<div class="grid-2-cols">
					<Input type="text" id="hero-badge" label="Etiqueta / Saludo" placeholder="Hola! yo soy" required />
					<Input type="text" id="hero-title" label="Nombre / Título principal" placeholder="Homer Moncayo" required />
				</div>

				<div class="editor-group">
					<label class="editor-label">Subtítulo / Descripción corta</label>
					<div id="hero-subtitle-editor" class="wysiwyg"></div>
				</div>

				<!-- Enlaces / Redes Sociales -->
				<div class="social-links-section">
					<div class="social-links-section__header">
						<div>
							<label class="editor-label" style="margin-bottom: 0;">Enlaces y Redes Sociales</label>
							<p class="section-hint">Personaliza los enlaces que aparecen debajo del subtítulo en el Hero.</p>
						</div>
						<button type="button" class="button button--secondary button--sm" id="add-social-link-btn">
							<i class="fa-solid fa-plus"></i>
							<span>Agregar enlace</span>
						</button>
					</div>

					<div class="social-links-list" id="social-links-list">
						<!-- Items generados dinámicamente con JS -->
					</div>
				</div>

				<div class="admin-modal__actions">
					<button type="submit" class="button button--primary" id="submit-hero-btn">Guardar Cambios</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Modal Editar Sobre Mí -->
	<div class="admin-modal" id="about-modal">
		<div class="admin-modal__content">
			<button type="button" class="admin-modal__close" id="close-about-modal">
				<i class="fa fa-times"></i>
			</button>
			<h2>Editar Sobre mí</h2>
			<form id="form-about">
				<Input type="text" id="about-badge" label="Etiqueta" placeholder="Sobre mi" required />
				<Input type="text" id="about-title" label="Título" placeholder="Un creador de software..." required />
				<div class="editor-group">
					<label class="editor-label">Texto (un párrafo por línea)</label>
					<div id="about-body-editor" class="wysiwyg"></div>
				</div>
				<div class="admin-modal__actions">
					<button type="submit" class="button button--primary" id="submit-about-btn">Guardar</button>
				</div>
			</form>
		</div>
	</div>
</AdminLayout>

<script define:vars={{ hero, about }} is:inline>
	window.__LANDING__ = { hero, about }
</script>

