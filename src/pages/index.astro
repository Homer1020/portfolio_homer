---
import Layout from '../layouts/Layout.astro'
import Services from '../components/home/Services.astro'
import Process from '../components/home/Process.astro'
import Stack from '../components/Stack.astro'
import ContactForm from '../components/ContactForm.astro'
---

<Layout
	title="Homer Developer | Desarrollo web a medida"
	description="Desarrollo web full-stack a medida: sitios, aplicaciones, APIs, e-commerce y mantenimiento. Cuéntame tu proyecto."
>
	<section class="s-hero">
		<div class="container">
			<p class="badge">Desarrollador Full-Stack</p>
			<h1 class="s-hero__title">¿Qué puedo hacer <span>por ti?</span></h1>
			<p class="s-hero__text">
				Convierto ideas en software limpio, moderno y escalable. Te ayudo a lanzar, mejorar y mantener tu producto digital.
			</p>
			<div class="s-hero__actions">
				<a href="#contacto" class="button button--primary">Hablemos de tu proyecto</a>
				<a href="/portfolio" class="button button--secondary-o">Ver portfolio <i class="fas fa-arrow-right"></i></a>
			</div>
		</div>
	</section>

	<Services />
	<Process />

	<section class="p-section bg-white" id="tecnologias">
		<div class="container container--sm">
			<p class="badge text-center">Tecnologías</p>
			<h2 class="text-center">Herramientas con las que trabajo</h2>
			<Stack />
		</div>
	</section>

	<section class="p-section cta-band">
		<div class="container">
			<h2>Mira lo que he construido</h2>
			<p>Proyectos reales, experiencia y testimonios de clientes en mi portfolio.</p>
			<a href="/portfolio" class="button">Ir al portfolio <i class="fas fa-arrow-right"></i></a>
		</div>
	</section>

	<section class="p-section" id="contacto">
		<div class="container">
			<p class="badge">Contacto</p>
			<h2>Cuéntame tu proyecto</h2>
			<ContactForm />
		</div>
	</section>
</Layout>
